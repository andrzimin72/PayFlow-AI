# =============================================================================
# PayFlow AI - Environment Configuration
# =============================================================================
# IMPORTANT: This file contains sensitive credentials.
# NEVER commit this file to version control!
# It should be listed in .gitignore
#
# For a template to commit, see .env.example
# =============================================================================

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# PAYPAL API CREDENTIALS (Sandbox)
# =============================================================================
# Get these from: https://developer.paypal.com/dashboard/
# Go to Apps & Credentials -> Sandbox -> Your App
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_SECRET=your_sandbox_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook ID (from PayPal Developer Dashboard)
# Go to Webhooks -> Your Webhook -> Copy the ID
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# =============================================================================
# HUGGING FACE API
# =============================================================================
# Get your token from: https://huggingface.co/settings/tokens
# Required for Mistral-7B inference
HF_TOKEN=your_huggingface_token_here

# =============================================================================
# ELASTICSEARCH
# =============================================================================
# For local Docker: http://localhost:9200
# For Docker Compose: http://elasticsearch:9200
# For Elastic Cloud: https://your-cluster.cloud.es.io:9243
ES_HOST=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX_NAME=payflow_transactions

# Retry configuration
ES_MAX_RETRIES=3
ES_RETRY_DELAY=1.0

# =============================================================================
# ZAPIER WEBHOOK (For Real-Time Alerts)
# =============================================================================
# Get this from Zapier when creating a Webhook trigger
ZAPIER_WEBHOOK_URL=

# =============================================================================
# NGROK (For Webhook Tunneling)
# =============================================================================
# Get your auth token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=

# =============================================================================
# TOKEN MANAGEMENT
# =============================================================================
# How many seconds before token expiry to refresh (default: 300 = 5 minutes)
TOKEN_REFRESH_BUFFER_SECONDS=300

# Maximum retry attempts for token refresh
TOKEN_MAX_RETRIES=3

# Delay between retry attempts (seconds)
TOKEN_RETRY_DELAY=1.0

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Maximum age for webhook transmission (prevents replay attacks)
MAX_TRANSMISSION_AGE_SECONDS=300

# Certificate cache TTL (seconds)
CERTIFICATE_CACHE_TTL_SECONDS=3600

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
# Risk score threshold for triggering alerts (0-100)
RISK_SCORE_THRESHOLD=60.0

# AI confidence threshold (below this triggers alerts)
CONFIDENCE_THRESHOLD=0.60

# =============================================================================
# OBSERVABILITY - OpenTelemetry
# =============================================================================
# Service identification
OTEL_SERVICE_NAME=payflow-api
OTEL_SERVICE_VERSION=4.0.0

# OTLP exporter endpoint (for Jaeger, Grafana Tempo, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# OBSERVABILITY - Grafana
# =============================================================================
GRAFANA_ADMIN_PASSWORD=admin123

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Default port for API
PORT=8000

# Default service: api, app, webhook
SERVICE=api

# =============================================================================
# AI MODEL SETTINGS
# =============================================================================
# Model for categorization
CATEGORIZATION_MODEL=facebook/bart-large-mnli

# Model for generative summaries
GENERATIVE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# =============================================================================
# FORECASTING SETTINGS
# =============================================================================
# Number of days to forecast
FORECAST_DAYS=30

# =============================================================================
# ANOMALY DETECTION
# =============================================================================
# Expected proportion of anomalies (0.1 = 10%)
ANOMALY_CONTAMINATION=0.1

# =============================================================================
# NOTES
# =============================================================================
# - Empty values (KEY=) mean the feature is disabled
# - For production, use a secrets manager (AWS Secrets Manager, etc.)
# - Rotate credentials regularly
# - Use different .env files for different environments:
#   .env.development, .env.staging, .env.production
# =============================================================================